{
  "manifest_version": 3,
  "name": "回声 · 播客连接器",
  "version": "0.1.1",
  "description": "将已登录的小宇宙和机核账号只读连接到本机 Podcast Memory。",
  "key": "",
  "permissions": ["cookies"],
  "host_permissions": [
    "https://podcaster.xiaoyuzhoufm.com/*",
    "https://www.gcores.com/*",
    "http://127.0.0.1:8787/*"
  ],
  "action": {
    "default_title": "连接播客账号",
    "default_popup": "popup.html"
  }
}
